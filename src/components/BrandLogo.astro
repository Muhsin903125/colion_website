---
/** A brand mark in a fixed box, greyscale at rest and full colour on hover. */
import Img from './Img.astro';
import type { Brand } from '../data/schema';

interface Props {
  brand: Brand;
  link?: boolean;
  class?: string;
  mono?: boolean;
  [key: string]: any;
}
const { brand: b, link = true, class: className = '', mono = true, ...rest } = Astro.props;
const Tag = link ? 'a' : 'span';
---
<Tag
  href={link ? `/brands/${b.slug}/` : undefined}
  class:list={['brand-logo group flex items-center justify-center', className]}
  title={b.name}
  {...rest}
>
  {b.logo?.publicId ? (
    <Img image={b.logo} alt={`${b.name} logo`} width={240} crop="limit" sizes="140px" class:list={['max-h-full max-w-full object-contain transition duration-500', mono && 'grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100']} />
  ) : (
    <span class="font-display text-lg font-bold tracking-tight text-slate transition group-hover:text-brand">{b.name}</span>
  )}
</Tag>
