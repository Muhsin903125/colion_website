---
/**
 * FAQ accordion on `<details>`: the answers are in the HTML whether open or
 * closed, so crawlers and answer engines read them; it works without JS.
 */
import Icon from './Icon.astro';
import { inline } from '../lib/inline';

interface Props {
  items: { q: string; a: string }[];
  /** Open the first item. */
  openFirst?: boolean;
  class?: string;
}
const { items, openFirst = true, class: className = '' } = Astro.props;
---
<div class:list={['divide-y divide-line overflow-hidden rounded-[22px] border border-line bg-white', className]}>
  {items.filter((f) => f.q && f.a).map((f, i) => (
    <details class="faq group" open={openFirst && i === 0}>
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 px-6 py-5 sm:px-7">
        <h3 class="font-display text-[1.02rem] font-semibold leading-snug text-ink">{f.q}</h3>
        <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sky text-brand transition-transform duration-300 group-open:rotate-45"><Icon name="plus" size={18} /></span>
      </summary>
      <div class="px-6 pb-6 sm:px-7">
        <p class="max-w-3xl text-[0.97rem] leading-[1.75] text-ink-soft" data-answer set:html={inline(f.a)} />
      </div>
    </details>
  ))}
</div>

<style>
  summary::-webkit-details-marker { display: none; }
  .faq[open] summary h3 { color: #1E3A8A; }
</style>
