---
import Icon from './Icon.astro';
import Img from './Img.astro';
import type { Category } from '../data/schema';

interface Props {
  category: Category;
  index?: number;
  brandCount?: number;
}
const { category: c, index = 0, brandCount } = Astro.props;
---
<a href={`/products/${c.slug}/`} class:list={['group relative block overflow-hidden rounded-[22px] border border-line bg-white reveal', `d${(index % 4) + 1}`]}>
  <div class="zoom relative aspect-[16/10] overflow-hidden bg-surface sm:aspect-[4/3]">
    <Img image={c.image} sizes="(min-width:1024px) 24vw, (min-width:640px) 45vw, 92vw" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 p-5 text-white">
      <Icon name={c.icon} size={22} class="mb-2 text-white/90" />
      <h3 class="font-display text-lg font-semibold !text-white">{c.name}</h3>
      {brandCount ? <p class="text-xs text-white/70">{brandCount} brands in stock</p> : null}
    </div>
    <span class="absolute right-4 top-4 flex h-10 w-10 translate-y-2 items-center justify-center rounded-full bg-white text-brand opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
  </div>
</a>
