---
/**
 * Product categories. `grid` is a four-up grid; `rail` is a dark, pinned
 * section whose cards slide horizontally as you scroll (desktop), or a
 * swipeable rail (touch). The rail is the home page's "sticky" moment.
 */
import CategoryCard from '../CategoryCard.astro';
import Icon from '../Icon.astro';
import Img from '../Img.astro';
import SectionHead from '../SectionHead.astro';
import { load } from '../../data/load';
import type { Section } from '../../data/schema';

type Props = Extract<Section, { type: 'categoryGrid' }>;
const s = Astro.props;
const d = await load();
const cats = (s.source === 'slugs' ? s.slugs.map(d.category).filter(Boolean) : d.categories) as NonNullable<ReturnType<typeof d.category>>[];
---
{s.layout === 'rail' ? (
  <section class="relative overflow-hidden bg-[#0b1a3f] text-white" data-horizontal>
    <div class="flex min-h-[100svh] flex-col justify-center py-20 lg:py-0">
      <div class="container-x mb-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHead intro={{ ...s.intro, cta: undefined as any }} dark />
        <p class="hidden items-center gap-2 text-sm text-white/60 lg:flex">Scroll to explore <Icon name="arrow" size={16} /></p>
      </div>
      <!-- The rail is clipped to the container, so cards start and end on its edges. -->
      <div class="container-x">
        <div class="overflow-hidden rounded-[24px]">
          <div class="no-scrollbar rail flex snap-x snap-mandatory gap-5 overflow-x-auto lg:snap-none" data-horizontal-track>
            {cats.map((c, i) => (
              <a href={`/products/${c.slug}/`} class="group relative block w-[64vw] shrink-0 snap-start overflow-hidden rounded-[24px] bg-white/5 ring-1 ring-white/10 sm:w-[300px]">
                <div class="relative aspect-[4/5] overflow-hidden">
                  <Img image={c.image} sizes="300px" class="h-full w-full object-cover transition duration-1000 group-hover:scale-105" />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0b1a3f] via-[#0b1a3f]/40 to-transparent" aria-hidden="true"></div>
                  <span class="absolute left-6 top-5 font-display text-sm font-semibold text-white/50">{String(i + 1).padStart(2, '0')} / {String(cats.length).padStart(2, '0')}</span>
                  <div class="absolute inset-x-0 bottom-0 p-6">
                    <Icon name={c.icon} size={24} class="mb-3 text-gold" />
                    <h3 class="font-display text-2xl font-semibold !text-white">{c.name}</h3>
                    <p class="mt-2 line-clamp-2 text-sm text-white/70">{c.tagline}</p>
                    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-gold">{d.brandsIn(c.slug).length} brands · View range <Icon name="arrow" size={15} class="transition group-hover:translate-x-1" /></span>
                  </div>
                </div>
              </a>
            ))}
            <a href="/products/" class="flex w-[52vw] shrink-0 snap-start flex-col items-start justify-end rounded-[24px] border border-white/15 p-7 transition hover:bg-white/5 sm:w-[260px]">
              <span class="font-display text-2xl font-semibold">All products</span>
              <span class="mt-2 text-sm text-white/60">{d.brands.length} brands, genuine UAE stock</span>
              <span class="mt-6 flex h-12 w-12 items-center justify-center rounded-full bg-gold text-ink"><Icon name="arrow-up-right" size={20} /></span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="section-y bg-surface">
    <div class="container-x">
      <SectionHead intro={s.intro} aside class="mb-12" />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {cats.map((c, i) => <CategoryCard category={c} index={i} brandCount={d.brandsIn(c.slug).length} />)}
      </div>
    </div>
  </section>
)}
