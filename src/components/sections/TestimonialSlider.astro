---
/**
 * Customer reviews. Only real ones belong here; until the first is added the
 * section invites visitors to read and leave Google reviews instead of
 * showing anything invented.
 */
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { load } from '../../data/load';
import type { Section } from '../../data/schema';

type Props = Extract<Section, { type: 'testimonialSlider' }>;
const s = Astro.props;
const d = await load();
const reviews = d.testimonials.filter((t) => t.quote && !t.placeholder);
const gbp = d.showroom?.gbp.url || d.corporate?.gbp.url || '';
const reviewUrl = d.showroom?.gbp.placeId ? `https://search.google.com/local/writereview?placeid=${d.showroom.gbp.placeId}` : gbp;
---
<section class="section-y relative overflow-hidden bg-sky">
  <div class="container-x">
    {reviews.length > 0 ? (
      <>
        <SectionHead intro={s.intro} aside class="mb-12" />
        <div class="no-scrollbar rail -mx-4 flex gap-5 overflow-x-auto px-4 pb-4">
          {reviews.map((r) => (
            <figure class="card w-[min(86vw,420px)] shrink-0 p-7">
              <div class="flex gap-0.5 text-gold">{Array.from({ length: Math.round(r.rating) }).map(() => <Icon name="star" size={18} />)}</div>
              <blockquote class="mt-4 text-[1.02rem] leading-relaxed text-ink">“{r.quote}”</blockquote>
              <figcaption class="mt-6 flex items-center justify-between gap-4 border-t border-line pt-4 text-sm">
                <span><strong class="block font-display text-ink">{r.author}</strong><span class="text-slate">{[r.role, r.company, r.emirate].filter(Boolean).join(' · ')}</span></span>
                {r.source === 'google' && r.sourceUrl && <a href={r.sourceUrl} target="_blank" rel="noopener" class="text-xs font-semibold text-brand">Google ↗</a>}
              </figcaption>
            </figure>
          ))}
        </div>
      </>
    ) : (
      <div class="relative grid items-center gap-8 overflow-hidden rounded-[28px] bg-gold p-8 text-ink sm:p-12 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <h2 class="h-section">Bought from us? <span class="text-brand-deep">Tell others how it went.</span></h2>
          <p class="mt-4 text-[1.05rem] leading-relaxed text-ink/80">Your review on Google helps other businesses in the UAE find a supplier they can trust — and tells us what to keep doing.</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch">
          {reviewUrl && <a href={reviewUrl} target="_blank" rel="noopener" class="btn btn-primary"><Icon name="star" size={17} /> Write a Google review</a>}
          {gbp && <a href={gbp} target="_blank" rel="noopener" class="btn border border-ink/20 bg-white/50 text-ink hover:bg-white">Read our reviews <Icon name="arrow-up-right" size={16} /></a>}
        </div>
      </div>
    )}
  </div>
</section>
