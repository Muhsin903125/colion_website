---
/**
 * Every brand, filterable by category and searchable by name, each linking to
 * its own page. The filter bar sticks under the header while the wall scrolls;
 * core brands carry a gold marker.
 */
import BrandLogo from '../BrandLogo.astro';
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { load } from '../../data/load';
import type { Section } from '../../data/schema';

type Props = Extract<Section, { type: 'logoWall' }>;
const s = Astro.props;
const d = await load();
const brands = [...d.brands].sort((a, b) => (a.tier === b.tier ? a.name.localeCompare(b.name) : a.tier === 'core' ? -1 : 1));
---
<section class="section-y" data-filter-root>
  <div class="container-x">
    <SectionHead intro={s.intro} class="mb-8" />

    <div class="sticky top-[72px] z-20 -mx-4 mb-8 border-y border-line/70 bg-white/85 px-4 py-3 backdrop-blur-xl sm:mx-0 sm:rounded-2xl sm:border sm:px-5 lg:top-[82px]">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-6">
        <label class="relative block shrink-0 lg:w-64">
          <span class="sr-only">Search brands</span>
          <Icon name="search" size={17} class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate" />
          <input type="search" placeholder="Search brands…" class="field !rounded-full !py-2.5 !pl-10" data-filter-search autocomplete="off" />
        </label>
        <div class="no-scrollbar -mx-4 flex flex-1 gap-1 overflow-x-auto px-4 lg:mx-0 lg:px-0" role="toolbar" aria-label="Filter brands by category">
          <button type="button" class="pill" data-filter="all" aria-pressed="true">All</button>
          {d.categories.map((c) => (
            <button type="button" class="pill" data-filter={c.slug} aria-pressed="false">{c.name}</button>
          ))}
        </div>
        <p class="hidden shrink-0 text-sm text-slate lg:block"><span class="font-display font-semibold text-ink" data-filter-count>{brands.length}</span> brands</p>
      </div>
    </div>

    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 lg:gap-4">
      {brands.map((b, i) => (
        <li data-filter-item data-name={b.name.toLowerCase()} data-tags={d.categoriesOf(b).map((c) => c.slug).join(' ')} class:list={['reveal', `d${(i % 4) + 1}`]}>
          <a href={`/brands/${b.slug}/`} class="wall group relative flex h-full flex-col items-center gap-3 overflow-hidden rounded-[20px] border border-line bg-white p-5 text-center">
            {b.tier === 'core' && <span class="absolute right-3 top-3 text-gold" title="Core brand"><Icon name="star" size={14} /></span>}
            <BrandLogo brand={b} link={false} class="h-14 w-full transition-transform duration-500 group-hover:scale-110" tabindex="-1" />
            <span class="font-display text-sm font-semibold text-ink transition-colors group-hover:text-brand">{b.name}</span>
            <span class="wall-arrow absolute bottom-0 left-0 h-[3px] w-full bg-gradient-to-r from-brand to-gold" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-10 hidden text-center text-slate" data-filter-empty>No brand matches that search. <a href="/contact/" class="inline-link">Ask us</a> — we source on request.</p>
  </div>
</section>

<style>
  .pill { white-space: nowrap; border-radius: 999px; padding: .5rem .95rem; font-size: .84rem; font-weight: 500; color: theme('colors.slate'); transition: background-color .25s, color .25s; }
  .pill:hover { color: theme('colors.ink.DEFAULT'); background: theme('colors.surface'); }
  .pill[aria-pressed='true'] { background: theme('colors.ink.DEFAULT'); color: #fff; }
  .wall { transition: transform .5s cubic-bezier(.2,.7,.2,1), box-shadow .5s, border-color .3s; }
  .wall:hover { transform: translateY(-5px); border-color: theme('colors.gold.DEFAULT'); box-shadow: 0 22px 46px -26px rgba(20,42,99,.45); }
  .wall-arrow { transform: scaleX(0); transform-origin: left; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .wall:hover .wall-arrow { transform: scaleX(1); }
</style>
