---
import Icon from '../Icon.astro';
import Img from '../Img.astro';
import SectionHead from '../SectionHead.astro';
import { load } from '../../data/load';
import type { Section } from '../../data/schema';

type Props = Extract<Section, { type: 'credentialsBand' }>;
const s = Astro.props;
const { credentials } = await load();
---
{credentials.length > 0 && (
  <section class="section-y-sm">
    <div class="container-x">
      <SectionHead intro={s.intro} align="center" class="mb-10" />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {credentials.map((c) => (
          <li class="card flex items-center gap-4 p-5 reveal">
            {c.image?.publicId ? <Img image={c.image} class="h-14 w-14 rounded-xl object-contain" sizes="56px" /> : <span class="icon-chip"><Icon name="award" /></span>}
            <div>
              <p class="font-display font-semibold text-ink">{c.title}</p>
              <p class="text-sm text-slate">{[c.issuer, c.year].filter(Boolean).join(' · ')}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
