---
/**
 * A question H2 and a self-contained 40–60 word answer — the paragraph shape a
 * featured snippet and an answer engine lift whole. `data-answer` is what the
 * speakable spec points at.
 *
 * With an image it becomes an image-led split: the photo on the left with a
 * location tag and a figure card floating over it, the answer on the right
 * over a faint outlined watermark, and the bullets as small icon tiles.
 */
import BgVideo from '../BgVideo.astro';
import Cta from '../Cta.astro';
import Icon from '../Icon.astro';
import Img from '../Img.astro';
import { load } from '../../data/load';
import { inline } from '../../lib/inline';
import type { Section } from '../../data/schema';

type Props = Extract<Section, { type: 'answerSection' }>;
const s = Astro.props;
const hasImage = Boolean(s.image?.publicId);
const d = await load();
const stat = d.stats[0];
const areas = d.site.locations.map((l) => l.area.split(',')[0]).join(' & ');
const ICONS = ['pin', 'warehouse', 'truck', 'globe', 'shield', 'tools'];
---
{s.question && (hasImage ? (
  <section class="section-y relative overflow-clip">
    <span class="watermark pointer-events-none absolute -right-6 top-6 hidden select-none font-display text-[13rem] font-bold leading-none lg:block" aria-hidden="true">COLION</span>
    <div class="container-x relative grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="relative reveal">
        <div class="absolute -left-4 -top-4 h-32 w-32 rounded-[28px] bg-gold/25 sm:-left-6 sm:-top-6 sm:h-40 sm:w-40" aria-hidden="true"></div>
        <div class="dots absolute -bottom-6 -right-4 h-28 w-28 opacity-60" aria-hidden="true"></div>
        <div class="media relative aspect-[16/10] shadow-lift lg:aspect-[4/3]" data-clip>
          {s.video ? (
            <BgVideo video={{ src: s.video, poster: s.image }} alt={s.image.alt} />
          ) : (
            <Img image={s.image} sizes="(min-width:1024px) 38vw, 100vw" class="h-full w-full scale-110 object-cover" data-parallax="0.08" />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-[#081634]/50 via-transparent to-transparent" aria-hidden="true"></div>
          <span class="absolute left-4 top-4 flex items-center gap-2 rounded-full bg-white/90 px-3.5 py-2 text-[0.78rem] font-semibold text-ink shadow-soft backdrop-blur sm:left-5 sm:top-5">
            <Icon name="pin" size={15} class="text-gold-deep" /> {areas}, Deira
          </span>
        </div>
        {stat && (
          <div class="float absolute -bottom-6 right-4 rounded-2xl bg-[#0b1a3f] px-5 py-4 text-white shadow-lift sm:-right-6 sm:px-6 sm:py-5">
            <p class="font-display text-3xl font-semibold text-gold sm:text-4xl"><span data-count={stat.value}>{stat.value}</span>{stat.unit}</p>
            <p class="mt-1 text-[0.8rem] text-white/70">{stat.label}</p>
          </div>
        )}
      </div>

      <div>
        {s.label && <p class="mb-4 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.18em] text-gold-deep reveal"><span class="h-px w-8 bg-gold"></span>{s.label}</p>}
        <h2 class="h-section reveal">{s.question}</h2>
        <p class="mt-5 text-[1.08rem] leading-[1.8] text-ink-soft" data-answer data-scrub-words set:html={inline(s.answer)} />
        {s.bullets.length > 0 && (
          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            {s.bullets.map((b, i) => (
              <li class:list={['tile flex items-center gap-3 rounded-2xl border border-line bg-white p-3.5 text-[0.92rem] font-semibold text-ink reveal', `d${(i % 4) + 1}`]}>
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gold-soft text-gold-deep"><Icon name={ICONS[i % ICONS.length]} size={19} /></span>
                <span class="leading-snug">{b}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="mt-9 flex flex-wrap items-center gap-3 reveal">
          {s.cta?.href && <Cta link={s.cta} variant="primary" />}
          <a href={d.waLink('Hello Colion International, I would like a quotation for:')} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-2 font-display text-sm font-semibold text-ink hover:text-brand" data-track="click_whatsapp"><Icon name="whatsapp" size={18} class="text-[#128C4A]" /> Chat with sales</a>
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="section-y-sm">
    <div class="container-x">
      <div class="relative mx-auto max-w-4xl overflow-hidden rounded-[28px] border border-gold/30 bg-gradient-to-br from-gold-soft/80 via-white to-white p-7 sm:p-10">
        {s.label && <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-gold-deep">{s.label}</p>}
        <h2 class="h-section reveal">{s.question}</h2>
        <p class="mt-5 text-[1.12rem] leading-[1.8] text-ink" data-answer data-scrub-words set:html={inline(s.answer)} />
        {s.bullets.length > 0 && (
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {s.bullets.map((b, i) => (
              <li class:list={['flex items-start gap-3 text-[0.95rem] font-medium text-ink reveal', `d${(i % 4) + 1}`]}>
                <Icon name="check" size={18} class="mt-0.5 shrink-0 text-gold-deep" />
                {b}
              </li>
            ))}
          </ul>
        )}
        {s.cta?.href && <div class="mt-8 reveal"><Cta link={s.cta} variant="outline" /></div>}
      </div>
    </div>
  </section>
))}

<style>
  .watermark { color: transparent; -webkit-text-stroke: 1.5px rgba(30, 58, 138, .07); letter-spacing: -.04em; }
  .dots { background-image: radial-gradient(theme('colors.brand.DEFAULT') 1.5px, transparent 1.5px); background-size: 14px 14px; }
  .tile { transition: border-color .3s, transform .4s cubic-bezier(.2,.7,.2,1), box-shadow .4s; }
  .tile:hover { border-color: theme('colors.gold.DEFAULT'); transform: translateY(-2px); box-shadow: 0 14px 30px -20px rgba(20,42,99,.35); }
  .float { animation: bob 6s ease-in-out infinite alternate; }
  @keyframes bob { from { translate: 0 -6px; } to { translate: 0 6px; } }
  @media (prefers-reduced-motion: reduce) { .float { animation: none; } }
</style>
