---
/**
 * The five promises as a bento: the first (delivery) is a large photo tile,
 * the other four sit beside it as numbered cards. Reads `features`.
 */
import Icon from '../Icon.astro';
import Img from '../Img.astro';
import SectionHead from '../SectionHead.astro';
import { load } from '../../data/load';
import type { Section } from '../../data/schema';

type Props = Extract<Section, { type: 'featureStrip' }>;
const s = Astro.props;
const { features } = await load();
const [lead, ...rest] = features;
const hasImage = Boolean(s.image?.publicId);
const hasIntro = s.intro.lines.some((t) => t.trim());
---
{features.length > 0 && (
  <section class="section-y-sm relative">
    <div class="container-x">
      {hasIntro && <SectionHead intro={s.intro} aside class="mb-10" />}
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:grid-rows-2">
        <li class="reveal sm:col-span-2 lg:row-span-2">
          <div class="relative flex h-full min-h-[300px] flex-col justify-end overflow-hidden rounded-[26px] bg-brand-deep p-7 text-white sm:min-h-[340px] sm:p-9">
            {hasImage && (
              <>
                <Img image={s.image} sizes="(min-width:1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full scale-110 object-cover" data-parallax="0.08" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0b1a3f] via-[#0b1a3f]/55 to-[#0b1a3f]/10" aria-hidden="true"></div>
              </>
            )}
            <div class="relative">
              <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-gold text-ink"><Icon name={lead.icon} size={22} /></span>
              <h3 class="font-display text-2xl font-semibold !text-white sm:text-3xl">{lead.title}</h3>
              <p class="mt-3 max-w-md text-white/80">{lead.body}</p>
            </div>
          </div>
        </li>
        {rest.map((f, i) => (
          <li class:list={['feat group reveal flex gap-4 sm:block', `d${(i % 4) + 1}`]}>
            <div class="flex shrink-0 items-start justify-between">
              <Icon name={f.icon} size={26} class="text-brand transition-colors group-hover:text-gold-deep" />
              <span class="hidden font-display text-sm font-semibold text-gold sm:inline">{String(i + 2).padStart(2, '0')}</span>
            </div>
            <div>
              <h3 class="h-card sm:mt-6">{f.title}</h3>
              <p class="mt-1.5 text-[0.9rem] leading-relaxed text-slate sm:mt-2">{f.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .feat {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background: #fff;
    border: 1px solid theme('colors.line');
    padding: 1.25rem;
    transition: transform .5s cubic-bezier(.2,.7,.2,1), box-shadow .5s, border-color .3s;
  }
  .feat::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: linear-gradient(90deg, theme('colors.brand.DEFAULT'), theme('colors.gold.DEFAULT'));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .6s cubic-bezier(.2,.7,.2,1);
  }
  @media (min-width: 640px) { .feat { padding: 1.6rem; } }
  .feat:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -22px rgba(20,42,99,.35); border-color: theme('colors.brand.100'); }
  .feat:hover::after { transform: scaleX(1); }
</style>
