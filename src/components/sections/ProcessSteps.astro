---
/**
 * Numbered steps as a real `<ol>` — the list shape a "how to" featured
 * snippet is built from. With an image, the heading and photo stay pinned on
 * the left while the steps run down a timeline whose line fills on scroll.
 */
import Img from '../Img.astro';
import SectionHead from '../SectionHead.astro';
import { inline } from '../../lib/inline';
import type { Section } from '../../data/schema';

type Props = Extract<Section, { type: 'processSteps' }>;
const s = Astro.props;
const hasImage = Boolean(s.image?.publicId);
---
<section class="section-y relative overflow-clip">
  {hasImage ? (
    <div class="container-x grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHead intro={s.intro} />
        <div class="media mt-8 hidden aspect-[4/3] shadow-soft lg:block" data-clip>
          <Img image={s.image} sizes="40vw" class="h-full w-full object-cover" />
        </div>
      </div>
      <ol class="relative" data-timeline>
        <span class="absolute bottom-6 left-[1.4rem] top-6 w-px bg-line" aria-hidden="true"></span>
        <span class="absolute bottom-6 left-[calc(1.4rem-0.5px)] top-6 w-0.5 origin-top bg-gold" data-timeline-fill aria-hidden="true"></span>
        {s.steps.map((st, i) => (
          <li class="reveal relative flex gap-5 pb-6 last:pb-0 sm:gap-7">
            <span class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-4 border-white bg-gold font-display text-sm font-bold text-ink shadow-soft">{i + 1}</span>
            <div class="flex-1 rounded-[20px] border border-line bg-white/95 p-5 shadow-[0_10px_30px_-20px_rgba(20,42,99,.3)] backdrop-blur sm:p-6">
              <h3 class="h-card">{st.title}</h3>
              <p class="mt-1.5 text-[0.93rem] leading-relaxed text-slate" set:html={inline(st.body)} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <div class="container-x">
      <SectionHead intro={s.intro} class="mb-10" />
      <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {s.steps.map((st, i) => (
          <li class:list={['card relative p-6 reveal', `d${(i % 4) + 1}`]}>
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gold font-display text-sm font-bold text-ink">{i + 1}</span>
            <h3 class="h-card mt-4">{st.title}</h3>
            <p class="mt-2 text-[0.93rem] leading-relaxed text-slate" set:html={inline(st.body)} />
          </li>
        ))}
      </ol>
    </div>
  )}
</section>
