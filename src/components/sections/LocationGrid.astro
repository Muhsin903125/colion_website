---
import Icon from '../Icon.astro';
import Img from '../Img.astro';
import SectionHead from '../SectionHead.astro';
import { load } from '../../data/load';
import type { Section } from '../../data/schema';

type Props = Extract<Section, { type: 'locationGrid' }>;
const s = Astro.props;
const d = await load();
---
<section class="section-y-sm">
  <div class="container-x">
    <SectionHead intro={s.intro} aside class="mb-8" />
    <ul class="grid auto-rows-[112px] grid-cols-2 gap-3 sm:auto-rows-[150px] sm:gap-4 lg:auto-rows-[165px] lg:grid-cols-5">
      {d.emirates.map((e, i) => (
        <li class:list={['reveal', i === 0 && 'col-span-2 row-span-2', `d${(i % 4) + 1}`]}>
          <a href={`/locations/${e.slug}/`} class="group relative block h-full overflow-hidden rounded-[20px] bg-brand-deep">
            <Img image={e.image} sizes={i === 0 ? '(min-width:1024px) 40vw, 100vw' : '(min-width:1024px) 20vw, 50vw'} class="absolute inset-0 h-full w-full scale-110 object-cover transition duration-1000 group-hover:scale-[1.15]" data-parallax="0.08" />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-deep/90 via-brand-deep/30 to-transparent" aria-hidden="true"></div>
            <div class="relative flex h-full flex-col justify-end p-4 text-white sm:p-5">
              <h3 class:list={['font-display font-semibold !text-white', i === 0 ? 'text-2xl sm:text-3xl' : 'text-base sm:text-lg']}>{e.name}</h3>
              <p class="mt-0.5 flex items-center gap-1.5 text-xs text-white/80 sm:text-sm"><Icon name="truck" size={15} class="text-gold" /> {e.deliveryTime}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-[0.7rem] text-slate">Emirate photos: Wikimedia Commons contributors, used under Creative Commons licences — credited on each emirate's page.</p>
  </div>
</section>
