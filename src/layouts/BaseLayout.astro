---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { abs, buildOrganization, buildStores, buildWebsite, SITE_URL } from '../data/seo';
import { verificationTags } from '../data/verification';
import { load } from '../data/load';
import { resolveImage } from '../lib/cloudinary';
import { plain } from '../lib/inline';

/*
 * The faces painted above the fold, preloaded: Manrope (body) and Sora
 * (headings). `?url` resolves to the hashed file the build
 * emits, so the preload and the stylesheet hit the same immutable asset.
 */
import body from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import display from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';

const d = await load();
const { site, seo } = d;

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative share image. */
  image?: string;
  imageAlt?: string;
  /** Page-specific schema nodes, merged into the site-wide @graph. */
  schema?: (object | null | undefined)[];
  noindex?: boolean;
  /** The hero poster, preloaded as the LCP candidate. */
  preloadImage?: string;
  /** Pages whose top is a dark band start with a transparent white header. */
  darkTop?: boolean;
}
const {
  title,
  description = plain(site.description),
  image = resolveImage(seo.defaultShare) || '/images/stills/hero-datacenter.webp',
  imageAlt,
  schema = [],
  noindex = false,
  preloadImage,
  darkTop = false,
} = Astro.props;

/**
 * Titles are budgeted to ~60 characters. The suffix is skipped when the page
 * title already names the company, so it is never said twice.
 */
const fullTitle = title
  ? /colion/i.test(title)
    ? title
    : `${title} | ${site.name}`
  : `IT Hardware Supplier in Dubai, UAE | ${site.name}`;

const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), SITE_URL).toString();
const ogImage = abs(image);

const graph = {
  '@context': 'https://schema.org',
  '@graph': [buildOrganization(d), ...buildStores(d), buildWebsite(d), ...schema.filter(Boolean)],
};

/**
 * `max-snippet:-1` and `max-image-preview:large` let Google and AI Overviews
 * quote a full answer and show the large image. `noindex, follow` keeps a thin
 * page out of the index while still passing its links.
 */
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!--
      GA4, loaded late: on the first interaction, a little after `load`, or at a
      3.5s ceiling, whichever comes first. The queue is set up synchronously, so
      events fired before the library arrives are still sent.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NGMLGFSZ5B');
      (function () {
        var loaded = false;
        var events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        function boot() {
          if (loaded) return;
          loaded = true;
          events.forEach(function (e) { window.removeEventListener(e, boot); });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-NGMLGFSZ5B';
          document.head.appendChild(s);
        }
        events.forEach(function (e) { window.addEventListener(e, boot, { once: true, passive: true }); });
        if (document.readyState === 'complete') setTimeout(boot, 1200);
        else window.addEventListener('load', function () { setTimeout(boot, 1200); }, { once: true });
        setTimeout(boot, 3500);
      })();
    </script>

    <link rel="preload" as="font" type="font/woff2" href={body} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={display} crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />

    {verificationTags.map((v) => <meta name={v.name} content={v.content} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_AE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#1E3A8A" />

    <meta name="author" content={site.legalName} />
    <meta name="geo.region" content="AE-DU" />
    <meta name="geo.placename" content="Deira, Dubai" />
    {d.showroom?.geo.lat ? <meta name="geo.position" content={`${d.showroom.geo.lat};${d.showroom.geo.lng}`} /> : null}
    {d.showroom?.geo.lat ? <meta name="ICBM" content={`${d.showroom.geo.lat}, ${d.showroom.geo.lng}`} /> : null}

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <ViewTransitions />
  </head>

  <body data-dark-top={darkTop ? 'true' : undefined}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-brand focus:px-5 focus:py-3 focus:text-white">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />

    <script>
      import '../scripts/main.ts';
    </script>
    <!-- Failsafe: if the scripts never run, never leave content hidden. -->
    <script is:inline>
      setTimeout(function () {
        if (!window.__colionMotion) {
          document.querySelectorAll('.reveal, .reveal-scale, [data-lines], [data-clip]').forEach(function (el) { el.classList.add('is-in'); });
        }
      }, 2500);
    </script>
  </body>
</html>
