---
/**
 * The CMS.
 *
 * Server-rendered rather than prerendered, so the page itself can be kept out
 * of the crawl and the session cookie is read on the server. Everything below
 * the shell is built by `src/scripts/admin/app.ts` against `/api/content`.
 *
 * Wears the site's colours and type (navy, gold, Sora and Manrope) so the
 * editor feels like part of the same brand, but none of its scroll
 * choreography: this is a tool, and motion would only slow it down.
 */
export const prerender = false;

import '@fontsource-variable/sora';
import '@fontsource-variable/manrope';
import { readContent } from '../lib/cms/store';

const content = await readContent();

/**
 * The sign-in screen reports on the site it guards.
 *
 * These come from the last published build rather than the live draft, so the
 * page needs no session to render them — and an editor arriving to make a
 * change can see at a glance what is currently live and when it went out.
 */
const stats = [
  { value: String(content.productCategories.length + content.services.length), label: 'Categories & services' },
  { value: String(content.brands.length), label: 'Brands' },
  { value: String(content.gallery.length), label: 'Gallery items' },
  { value: String(content.faqGroups.flatMap((g) => g.items).length), label: 'Answers' },
  {
    value: String(Object.values(content.pages).reduce((n, p) => n + p.sections.length, 0)),
    label: 'Sections',
  },
];

const published = content.updatedAt
  ? new Intl.DateTimeFormat('en-GB', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: 'Asia/Dubai',
    }).format(new Date(content.updatedAt))
  : null;

/** The three stills behind the sign-in panel, in the order they fade. */
const plates = ['/images/gallery/photo-04.webp', '/images/gallery/photo-25.webp', '/images/gallery/photo-01.webp'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Never indexed, and never followed into the API. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>Colion CMS</title>
    <link rel="icon" type="image/png" href="/favicon-32.png?v=2" />
  </head>
  <body>
    <!--
      Sign-in takes over the whole viewport rather than sitting inside the app
      shell: there is nothing to do behind it, and a half-visible panel of
      disabled tabs only invites clicking at them.
    -->
    <div id="login" class="login" hidden>
      <figure class="login-art">
        {plates.map((src, i) => (
          <img src={src} alt="" aria-hidden="true" class:list={['plate', i === 0 && 'is-on']} data-plate />
        ))}
        <span class="login-art-scrim" aria-hidden="true"></span>

        <figcaption class="login-art-copy">
          <img class="login-logo" src="/images/brand/colion-logo-white.webp" width="640" height="159" alt="Colion International" />
          <p class="login-lede">{content.site.positioning}</p>
          <p class="login-sub">
            Every word, photograph and reel on colioninternational.com is edited here. Changes are
            saved as a draft, and go live when you publish.
          </p>

          <dl class="login-stats">
            {stats.map((s) => (
              <div>
                <dt>{s.value}</dt>
                <dd>{s.label}</dd>
              </div>
            ))}
          </dl>

          <p class="login-meta">
            {published ? `Last published ${published} (Gulf Standard Time)` : 'Not published yet'}
          </p>
        </figcaption>
      </figure>

      <div class="login-side">
        <form id="login-form" class="login-card">
          <span class="login-eyebrow">Content management</span>
          <h1>Sign in</h1>
          <p>Enter the CMS password to edit the site.</p>

          <label for="password">Password</label>
          <input id="password" type="password" autocomplete="current-password" placeholder="••••••••••" />
          <button class="btn btn-primary btn-block" type="submit">Sign in</button>

          <p class="login-help">
            Forgotten it? It is stored as <code>CMS_ADMIN_PASSWORD</code> in the Vercel project
            settings — there is no copy in the codebase, and no reset link.
          </p>
        </form>

        <ul class="login-tips">
          <li><strong>Save</strong> keeps a draft. Nothing changes on the live site.</li>
          <li><strong>Publish</strong> makes the saved draft public — live in seconds.</li>
          <li>Replacing a photograph updates it everywhere it is used at once.</li>
        </ul>

        <a class="login-back" href="/">← Back to colioninternational.com</a>
      </div>
    </div>

    <header class="bar">
      <div class="bar-in">
        <span class="brand"><img src="/images/brand/colion-logo-white.webp" width="640" height="159" alt="Colion International" /><em>CMS</em></span>
        <div class="bar-actions">
          <a href="/" class="btn btn-ghost" target="_blank" rel="noopener">View site</a>
          <button id="reload" class="btn btn-ghost" type="button">Reload</button>
          <button id="logout" class="btn btn-ghost" type="button" hidden>Sign out</button>
          <button id="save" class="btn" type="button" disabled>Saved</button>
          <button id="publish" class="btn btn-primary" type="button" disabled>Publish</button>
        </div>
      </div>
    </header>

    <main class="shell">
      <aside class="side">
        <nav>
          <button class="tab is-on" type="button" data-tab="site">Site</button>
          <button class="tab" type="button" data-tab="seo">SEO</button>
          <button class="tab" type="button" data-tab="pages">Pages</button>
          <button class="tab" type="button" data-tab="gallery">Gallery</button>
          <button class="tab" type="button" data-tab="services">Services</button>
          <button class="tab" type="button" data-tab="categories">Products</button>
          <button class="tab" type="button" data-tab="brands">Brands</button>
          <button class="tab" type="button" data-tab="locations">Emirates</button>
          <button class="tab" type="button" data-tab="team">Team & reviews</button>
          <button class="tab" type="button" data-tab="faqs">FAQ</button>
          <button class="tab" type="button" data-tab="highlights">Highlights</button>
          <button class="tab" type="button" data-tab="media">Media</button>
        </nav>
        <p id="status" class="status">Loading…</p>
      </aside>

      <section class="main">
        <div id="workspace" hidden>
          <div id="panel" class="panel"></div>
        </div>
      </section>
    </main>

    <script>
      import { start } from '../scripts/admin/app';
      start();

      // Cross-fade the sign-in stills. Stops as soon as the panel is hidden, so
      // it is not still running behind the editor for the rest of the session.
      const plates = [...document.querySelectorAll<HTMLElement>('[data-plate]')];
      const login = document.getElementById('login');

      if (plates.length > 1 && login && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let index = 0;
        const timer = setInterval(() => {
          if (login.hidden) return clearInterval(timer);
          plates[index].classList.remove('is-on');
          index = (index + 1) % plates.length;
          plates[index].classList.add('is-on');
        }, 5200);
      }
    </script>

    <style is:global>
      /* The site's own palette (tailwind.config.mjs): navy, gold, surface. */
      :root {
        --bg: #F6F8FC;
        --panel: #FFFFFF;
        --card: #F1F4FA;
        --line: #E3E8F2;
        --text: #0B1B3F;
        --muted: #5B6880;
        --brand: #1E3A8A;
        --brand-deep: #0B1A3F;
        --brand-soft: #EEF3FF;
        --gold: #D5A540;
        --gold-deep: #8A6516;
        --gold-soft: #F6EBCF;
        --ok: #1F7A4A;
        --danger: #C2410C;
        color-scheme: light;
      }

      * { box-sizing: border-box; }

      /* A `display` rule beats the hidden attribute's UA `display: none`, and
         several blocks below set one — so state the intent once, here. */
      [hidden] { display: none !important; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 14px/1.55 "Manrope Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      h1, h2, h3, .btn, .tab, .brand { font-family: "Sora Variable", "Manrope Variable", system-ui, sans-serif; }

      /*
       * Scrollbars.
       *
       * The default light-on-white bar is jarring against this panel and, on
       * Windows, wide enough to crowd the form. Styled in both dialects because
       * neither is universal: `scrollbar-color` covers Firefox, the WebKit
       * pseudo-elements cover Chromium and Safari.
       *
       * The track is left visible rather than transparent — an overlay-style
       * invisible bar makes it genuinely hard to tell a long section list is
       * scrollable at all.
       */
      * {
        scrollbar-width: thin;
        scrollbar-color: var(--line) transparent;
      }

      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb {
        background: var(--line);
        border-radius: 999px;
        /* A transparent border, clipped to the content box, insets the thumb so
           it reads as a rail rather than filling the gutter edge to edge. */
        border: 3px solid transparent;
        background-clip: content-box;
      }
      ::-webkit-scrollbar-thumb:hover { background: #C5CEDF; background-clip: content-box; }
      ::-webkit-scrollbar-corner { background: transparent; }

      /* The preview stage sits on the darkest ground, so its rail needs to be
         a shade lighter to stay visible. */
      .preview-stage { scrollbar-color: #C5CEDF transparent; }
      .preview-stage::-webkit-scrollbar-thumb { background: #C5CEDF; background-clip: content-box; }

      /* ── chrome ─────────────────────────────────────────────────────── */

      .bar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--brand-deep);
        border-bottom: 3px solid var(--gold);
        color: #fff;
      }
      .bar-in {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.7rem 1.2rem;
      }
      .brand { display: flex; align-items: center; gap: 0.7rem; }
      .brand img { height: 28px; width: auto; display: block; }
      .brand em { color: var(--gold); font-style: normal; font-weight: 600; letter-spacing: 0.2em; font-size: 0.7rem; padding-left: 0.7rem; border-left: 1px solid rgba(255,255,255,.2); }
      .bar .btn { background: transparent; border-color: rgba(255,255,255,.22); color: #fff; }
      .bar .btn:hover:not(:disabled) { border-color: var(--gold); color: var(--gold); }
      .bar .btn-primary { background: var(--gold); border-color: var(--gold); color: var(--text); }
      .bar .btn-primary:hover:not(:disabled) { filter: brightness(1.06); color: var(--text); }
      .bar .btn:disabled { opacity: 0.5; }
      .bar-actions { display: flex; gap: 0.5rem; align-items: center; }

      .shell { display: grid; grid-template-columns: 210px 1fr; min-height: calc(100vh - 60px); }

      .side {
        border-right: 1px solid var(--line);
        padding: 1rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: sticky;
        top: 60px;
        height: calc(100vh - 60px);
        background: var(--panel);
      }
      .side nav { display: flex; flex-direction: column; gap: 2px; }

      .tab {
        appearance: none;
        background: none;
        border: 0;
        color: var(--muted);
        text-align: left;
        padding: 0.55rem 0.8rem;
        border-radius: 10px;
        font-size: 0.86rem;
        font-weight: 500;
        cursor: pointer;
        position: relative;
      }
      .tab:hover:not(:disabled) { background: var(--brand-soft); color: var(--brand); }
      .tab.is-on { background: var(--brand); color: #fff; }
      .tab.is-on::after { content: ''; position: absolute; right: 0.7rem; top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; background: var(--gold); }
      .tab:disabled { opacity: 0.35; cursor: not-allowed; }

      .status { margin: auto 0 0; color: var(--muted); font-size: 0.75rem; line-height: 1.5; }
      .status[data-kind='error'] { color: var(--danger); }

      .main { min-width: 0; }
      .panel { padding: 1.5rem; max-width: 900px; }

      /* Title and blurb on the left, the way out to the live page on the
         right — where the eye already goes for this panel's actions. It wraps
         under the text on a narrow panel rather than squeezing the blurb. */
      .panel-head {
        margin-bottom: 1.5rem;
        display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem;
        align-items: flex-start; justify-content: space-between;
      }
      .panel-head-text { flex: 1 1 22rem; min-width: 0; }
      .panel-head h1 { margin: 0 0 0.35rem; font-size: 1.5rem; font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
      .panel-head p { margin: 0; color: var(--muted); max-width: 62ch; }
      .panel-head-view { flex: none; text-decoration: none; }

      /* ── buttons ────────────────────────────────────────────────────── */

      .btn {
        appearance: none;
        background: var(--card);
        border: 1px solid var(--line);
        color: var(--text);
        border-radius: 999px;
        padding: 0.45rem 0.95rem;
        font-size: 0.84rem;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        transition: background-color .2s, border-color .2s, color .2s;
      }
      .btn:hover:not(:disabled) { border-color: var(--brand); color: var(--brand); }
      .btn:disabled { opacity: 0.45; cursor: not-allowed; }
      .btn-primary { background: var(--brand); border-color: var(--brand); color: #fff; font-weight: 600; }
      .btn-primary:hover:not(:disabled) { background: var(--brand-deep); border-color: var(--brand-deep); color: #fff; }
      .btn-ghost { background: none; }
      .btn-sm { padding: 0.3rem 0.65rem; font-size: 0.8rem; }
      .btn-icon { padding: 0.25rem 0.5rem; line-height: 1; }
      .btn-danger:hover:not(:disabled) { border-color: var(--danger); color: var(--danger); }

      /* ── cards and fields ───────────────────────────────────────────── */

      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.1rem 1.2rem 1.3rem;
        margin-bottom: 1rem;
        box-shadow: 0 8px 24px -18px rgba(11, 27, 63, .35);
      }
      .card > h2 { margin: 0 0 0.9rem; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold-deep); }
      .card-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.9rem; }
      .card-head h2 { margin: 0; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold-deep); }

      .grid { display: grid; gap: 0.9rem; }
      .stack { display: grid; gap: 0.9rem; }

      .f { display: grid; gap: 0.3rem; }
      .f > label { font-size: 0.78rem; font-weight: 600; color: #33415C; }
      .f input,
      .f textarea,
      .f select,
      .card select {
        width: 100%;
        background: #fff;
        border: 1px solid var(--line);
        color: var(--text);
        border-radius: 10px;
        padding: 0.55rem 0.7rem;
        font: inherit;
        resize: vertical;
      }
      .f input:focus, .f textarea:focus, .f select:focus { outline: none; border-color: #2563EB; box-shadow: 0 0 0 4px #DCE6FF; }
      .f input[type='color'] { padding: 0.2rem; height: 2.2rem; }
      .f-help { margin: 0.15rem 0 0; font-size: 0.72rem; color: var(--muted); line-height: 1.5; }
      .f-check { display: flex; align-items: center; gap: 0.45rem; font-size: 0.85rem; }
      .empty { color: var(--muted); font-size: 0.85rem; margin: 0; }

      /* ── repeaters ──────────────────────────────────────────────────── */

      .repeat { display: grid; gap: 0.75rem; }
      .repeat-item { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 0.85rem; }

      /* Rows are <details>. The default marker is replaced by a chevron on the
         title so the whole head reads as one target, and the head only earns
         its bottom margin once there is a body under it to separate. */
      .repeat-item > summary { cursor: pointer; list-style: none; margin-bottom: 0; }
      .repeat-item > summary::-webkit-details-marker { display: none; }
      .repeat-item[open] > summary { margin-bottom: 0.9rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--line); }

      .repeat-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.75rem; }
      .repeat-head h3 { margin: 0; font-size: 0.9rem; font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .repeat-item > summary > h3::before {
        content: '▸';
        display: inline-block;
        width: 1em;
        color: var(--muted);
        transition: transform 0.15s ease;
      }
      .repeat-item[open] > summary > h3::before { transform: rotate(90deg); }
      .repeat-tools { display: flex; gap: 0.25rem; flex-shrink: 0; }
      .repeat-item .card { background: var(--panel); }

      /* ── sections ───────────────────────────────────────────────────── */

      .section-item > summary { cursor: pointer; list-style: none; margin-bottom: 0; }
      .section-item > summary::-webkit-details-marker { display: none; }
      .section-item[open] > summary { margin-bottom: 0.9rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--line); }
      .section-item.is-hidden { opacity: 0.55; }
      .section-title { display: flex; align-items: baseline; gap: 0.6rem; min-width: 0; }
      .section-sub { color: var(--muted); font-size: 0.8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .badge { background: var(--brand-soft); color: var(--brand); border-radius: 3px; padding: 0.05rem 0.35rem; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; }
      .section-body { display: grid; gap: 0.9rem; }
      .add-picker { background: var(--card); border: 1px solid var(--line); color: var(--text); border-radius: 6px; padding: 0.35rem 0.5rem; font: inherit; }

      .chooser { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.2rem; }
      .chip { appearance: none; background: var(--panel); border: 1px solid var(--line); color: var(--muted); border-radius: 999px; padding: 0.3rem 0.8rem; font: inherit; font-size: 0.82rem; cursor: pointer; }
      .chip.is-on { background: var(--brand); border-color: var(--brand); color: #fff; }

      /* Swatch, hex and clear on one line. The hex takes the slack so a pasted
         value is readable at any panel width, and the swatch keeps the square
         it needs to read as a colour rather than as a control. */
      .color-row { display: flex; gap: 0.4rem; align-items: center; }
      .color-row input[type='color'] { width: 2.6rem; flex: none; }
      .color-row input[type='text'] { flex: 1; min-width: 0; }

      .range-row { display: flex; gap: 0.6rem; align-items: center; }
      /* The generic `.f input` frame is meant for a text box; on a slider it
         draws a second track around the real one. */
      .range-row input[type='range'] { flex: 1; min-width: 0; padding: 0; border: 0; background: none; accent-color: var(--brand); }
      .range-value { flex: none; min-width: 3ch; text-align: right; font-size: 0.78rem; color: var(--muted); font-variant-numeric: tabular-nums; }

      /* ── media ──────────────────────────────────────────────────────── */

      .media-row { display: flex; gap: 0.75rem; align-items: flex-start; }
      .media-preview { width: 84px; height: 84px; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); }
      .media-controls { display: flex; flex-wrap: wrap; gap: 0.35rem; }
      /* The size note sits under the buttons, on its own line, so the row of
         controls keeps its shape whatever the recommendation says. */
      .media-size { flex: 1 0 100%; margin: 0.1rem 0 0; }
      .f-media > input[type='text'] { width: 100%; background: #fff; border: 1px solid var(--line); color: var(--text); border-radius: 6px; padding: 0.45rem 0.6rem; font: inherit; margin-top: 0.4rem; }

      .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.75rem; }
      .tile { position: relative; display: grid; gap: 0.25rem; background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 0.5rem; text-align: left; color: inherit; font: inherit; cursor: pointer; }
      .tile img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; background: var(--bg); }
      .tile-cap { font-size: 0.72rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .tile-meta { font-size: 0.66rem; color: var(--muted); }
      .tile-del { position: absolute; top: 0.6rem; right: 0.6rem; background: rgba(11,26,63,.75); color: #fff; border-color: transparent; }

      /* ── modal ──────────────────────────────────────────────────────── */

      .modal { position: fixed; inset: 0; background: rgba(11,26,63,.55); display: grid; place-items: center; z-index: 50; padding: 1.5rem; }
      .modal-panel { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 30px 70px -30px rgba(11,27,63,.5); width: min(920px, 100%); max-height: 84vh; display: flex; flex-direction: column; }
      .modal-head { display: flex; align-items: center; justify-content: space-between; padding: 0.9rem 1.1rem; border-bottom: 1px solid var(--line); }
      .modal-head h2 { margin: 0; font-size: 0.95rem; }
      .modal-body { padding: 1.1rem; overflow: auto; }

      /* ── login ──────────────────────────────────────────────────────── */

      .login {
        position: fixed;
        inset: 0;
        z-index: 40;
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        background: var(--bg);
        overflow: auto;
      }

      /* The art side: three stills cross-fading behind a heavy scrim. */
      .login-art { position: relative; margin: 0; overflow: hidden; display: flex; align-items: flex-end; }
      .plate {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.06);
        transition: opacity 1.6s ease, transform 9s ease-out;
      }
      .plate.is-on { opacity: 1; transform: scale(1); }
      .login-art-scrim {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(105deg, rgba(11,26,63,.94) 8%, rgba(11,26,63,.6) 55%, rgba(11,26,63,.82) 100%),
          linear-gradient(to top, rgba(8,22,52,.96), transparent 62%);
      }

      .login-art-copy { position: relative; padding: clamp(1.75rem, 4vw, 3.25rem); max-width: 40rem; }
      .login-logo { display: block; height: 40px; width: auto; }
      .login-lede { margin: 1.5rem 0 0; font-family: "Sora Variable", sans-serif; font-weight: 600; font-size: clamp(1.3rem, 2.4vw, 1.9rem); line-height: 1.25; color: #fff; max-width: 22ch; }
      .login-sub { margin: 0.9rem 0 0; color: rgba(255,255,255,.72); max-width: 46ch; line-height: 1.7; }

      .login-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin: 2rem 0 0;
        padding-top: 1.4rem;
        border-top: 1px solid rgba(255, 255, 255, 0.16);
        max-width: 30rem;
      }
      .login-stats div { min-width: 0; }
      .login-stats dt { font-family: "Sora Variable", sans-serif; font-weight: 600; font-size: 1.7rem; line-height: 1; color: var(--gold); }
      .login-stats dd { margin: 0.4rem 0 0; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,.6); }
      .login-meta { margin: 1.6rem 0 0; font-size: 0.72rem; color: rgba(255,255,255,.6); }

      /* The form side. */
      .login-side {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.5rem;
        padding: clamp(1.5rem, 4vw, 3.25rem);
        background: var(--panel);
        border-left: 1px solid var(--line);
      }
      .login-card { width: min(24rem, 100%); }
      .login-eyebrow { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-deep); }
      .login-card h1 { margin: 0.7rem 0 0.3rem; font-size: 1.9rem; font-weight: 600; color: var(--text); }
      .login-card > p { margin: 0 0 1.4rem; color: var(--muted); }
      .login-card label { display: block; font-size: 0.78rem; font-weight: 600; color: #33415C; margin-bottom: 0.35rem; }
      .login-card input {
        width: 100%;
        background: #fff;
        border: 1px solid var(--line);
        color: var(--text);
        border-radius: 12px;
        padding: 0.75rem 0.9rem;
        font: inherit;
        letter-spacing: 0.1em;
      }
      .login-card input:focus { outline: none; border-color: #2563EB; box-shadow: 0 0 0 4px #DCE6FF; }
      .btn-block { width: 100%; margin-top: 0.9rem; padding: 0.75rem; font-size: 0.92rem; }
      .login-help { margin: 1.1rem 0 0; font-size: 0.72rem; line-height: 1.65; color: var(--muted); }
      .login-help code { background: var(--card); border: 1px solid var(--line); border-radius: 3px; padding: 0.05rem 0.3rem; font-size: 0.9em; }

      .login-tips { margin: 0; padding: 1.1rem 0 0; list-style: none; border-top: 1px solid var(--line); width: min(24rem, 100%); display: grid; gap: 0.55rem; }
      .login-tips li { font-size: 0.76rem; color: var(--muted); line-height: 1.6; padding-left: 0.9rem; position: relative; }
      .login-tips li::before { content: '◆'; position: absolute; left: 0; top: 0.05rem; color: var(--gold); font-size: 0.5rem; }
      .login-tips strong { color: var(--text); font-weight: 600; }
      .login-back { font-size: 0.74rem; color: var(--muted); text-decoration: none; }
      .login-back:hover { color: var(--brand); }

      @media (max-width: 900px) {
        .login { grid-template-columns: 1fr; }
        /* The art becomes a banner rather than disappearing — on a phone the
           panel is the only thing identifying which site this edits. */
        .login-art { min-height: 42vh; }
        .login-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .login-side { border-left: 0; border-top: 1px solid var(--line); }
      }
      @media (prefers-reduced-motion: reduce) {
        .plate { transition: opacity .4s linear; transform: none; }
        .plate.is-on { transform: none; }
      }

      /* ── confirmation dialog ────────────────────────────────────────── */

      .confirm-overlay { z-index: 70; }

      .confirm-panel {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 1.5rem;
        width: min(30rem, 100%);
        box-shadow: 0 30px 70px -30px rgba(11, 27, 63, 0.5);
      }
      .confirm-title { margin: 0 0 0.6rem; font-size: 1.1rem; font-weight: 600; }
      .confirm-body { margin: 0; color: var(--muted); line-height: 1.65; }

      .confirm-warning {
        margin: 0.9rem 0 0;
        padding: 0.6rem 0.75rem;
        border-left: 2px solid var(--danger);
        background: rgba(194, 65, 12, 0.07);
        color: var(--text);
        font-size: 0.85rem;
        line-height: 1.6;
      }

      .confirm-actions { display: flex; justify-content: flex-end; gap: 0.6rem; margin-top: 1.4rem; }
      .confirm-actions .btn { padding: 0.5rem 1.1rem; }

      /* Destructive confirm reads as danger, not as the default action. */
      .btn-confirm-danger { background: var(--danger); border-color: var(--danger); color: #fff; font-weight: 600; }
      .btn-confirm-danger:hover:not(:disabled) { filter: brightness(1.1); border-color: var(--danger); }

      /* ── preview drawer ─────────────────────────────────────────────── */

      .preview {
        position: fixed;
        top: 60px;
        right: 0;
        bottom: 0;
        width: min(46vw, 720px);
        z-index: 30;
        background: var(--panel);
        border-left: 1px solid var(--line);
        display: flex;
        flex-direction: column;
        box-shadow: -18px 0 40px rgba(11, 27, 63, 0.18);
      }

      /* The panel shifts rather than overlapping, so an editor can type in a
         field and watch the same field change without moving the window. */
      body.has-preview .panel { margin-right: min(46vw, 720px); }

      .preview-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.6rem 0.85rem;
        border-bottom: 1px solid var(--line);
        flex-shrink: 0;
      }
      .preview-heading { display: grid; min-width: 0; }
      .preview-title { font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .preview-state { font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-deep); }

      .preview-toggle { display: flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
      .preview-mode {
        appearance: none;
        background: none;
        border: 0;
        color: var(--muted);
        font: inherit;
        font-size: 0.72rem;
        padding: 0.3rem 0.6rem;
        cursor: pointer;
      }
      .preview-mode.is-on { background: var(--brand); color: #fff; }

      .preview-stage {
        flex: 1;
        min-height: 0;
        overflow: auto;
        padding: 1rem;
        background: var(--bg);
        display: flex;
        justify-content: center;
        align-items: flex-start;
      }

      /* Carries the scaled size, because a transform leaves layout size alone. */
      .preview-holder { flex-shrink: 0; }

      .preview-frame {
        display: block;
        border: 1px solid var(--line);
        border-radius: 4px;
        background: #fff;
        transform-origin: top left;
      }

      .preview-note {
        margin: 0;
        padding: 0.5rem 0.85rem;
        border-top: 1px solid var(--line);
        font-size: 0.68rem;
        color: var(--muted);
        flex-shrink: 0;
      }

      @media (max-width: 1100px) {
        /* Below this the drawer would leave no usable room for the form, so it
           takes the screen instead of splitting it. */
        .preview { width: 100%; left: 0; }
        body.has-preview .panel { margin-right: 0; }
      }

      /* ── toast ──────────────────────────────────────────────────────── */

      .toast {
        position: fixed;
        left: 50%;
        bottom: 1.5rem;
        transform: translate(-50%, 1rem);
        background: var(--brand-deep);
        border: 1px solid var(--brand-deep);
        color: #fff;
        border-radius: 999px;
        padding: 0.65rem 1.2rem;
        box-shadow: 0 18px 40px -20px rgba(11, 27, 63, .6);
        opacity: 0;
        transition: opacity .25s, transform .25s;
        cursor: pointer;
        z-index: 60;
        max-width: min(520px, 90vw);
      }
      .toast.is-in { opacity: 1; transform: translate(-50%, 0); }
      .toast-error { background: #fff; border-color: var(--danger); color: var(--danger); }

      @media (max-width: 820px) {
        .shell { grid-template-columns: 1fr; }
        .side { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--line); }
        .side nav { flex-direction: row; flex-wrap: wrap; }
      }
      /* ── Colion additions: quality badges and the gallery uploader ───── */
      .quality { margin: 0 0 .4rem; padding: .55rem .8rem; border-radius: 8px; font-size: 12.5px; }
      .quality-ok { background: rgba(31, 122, 74, .1); color: var(--ok); }
      .quality-no { background: var(--gold-soft); color: var(--gold-deep); }
      .dropzone { display: grid; place-items: center; gap: .35rem; padding: 2.4rem 1rem; margin-bottom: 1rem; border: 2px dashed var(--line); border-radius: 14px; background: var(--card); text-align: center; cursor: pointer; transition: border-color .2s, background .2s; }
      .dropzone strong { font-size: 16px; }
      .dropzone span { color: var(--muted); font-size: 13px; }
      .dropzone:hover, .dropzone.is-over { border-color: var(--brand); background: var(--brand-soft); }
      .dropzone.is-disabled { cursor: not-allowed; opacity: .7; }
      .upload-queue { display: grid; gap: .35rem; margin-bottom: 1rem; }
      .upload-row { display: grid; grid-template-columns: 1fr 180px; gap: .8rem; align-items: center; font-size: 12.5px; color: var(--muted); }
      .upload-row.is-done { color: var(--ok); }
      .upload-row.is-error { color: var(--danger); }
      .upload-bar { width: 100%; height: 6px; }
      .gallery-actions { display: flex; justify-content: flex-end; margin: .5rem 0 1rem; }
      .gallery-edit { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; }
      .g-card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 12px; background: var(--card); overflow: hidden; }
      .g-media { position: relative; aspect-ratio: 4 / 3; background: #000; }
      .g-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .g-kind { position: absolute; left: .5rem; top: .5rem; padding: .15rem .5rem; border-radius: 6px; background: rgba(11,26,63,.75); color: #fff; font-size: 11px; }
      .g-body { padding: .8rem; display: grid; gap: .5rem; }
      .g-tags { display: flex; flex-wrap: wrap; gap: .3rem; }
      .tag { padding: .2rem .55rem; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--muted); font-size: 11.5px; cursor: pointer; }
      .tag.is-on { background: var(--brand); border-color: var(--brand); color: #fff; }
      .g-more summary { cursor: pointer; color: var(--muted); font-size: 12px; }
      .g-tools { display: flex; justify-content: flex-end; gap: .3rem; padding: 0 .8rem .8rem; }

    </style>
  </body>
</html>
