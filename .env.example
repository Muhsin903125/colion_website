# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# In production these live in Vercel → Project → Settings → Environment
# Variables. Nothing here has a default in the code, and no secret is committed
# anywhere in the repo.

# ── CMS ────────────────────────────────────────────────────────────────────
# REQUIRED. The admin password, read straight from the environment. Without it
# the admin is open in local development and closed in production.
CMS_ADMIN_PASSWORD=

# RECOMMENDED. Signs the admin session cookie — any long random string.
# Falls back to CMS_ADMIN_PASSWORD if unset, which works but ties the two
# together: changing the password then signs everyone out.
CMS_SESSION_SECRET=

# REQUIRED FOR PUBLISHING. A secret random string of your choosing.
#
# Pages render from the store and are cached at Vercel's edge; Publish purges
# that cache by re-requesting each path with this token in the
# `x-prerender-revalidate` header. Without it the admin can still save, but
# nothing reaches the public site.
#
# It is read at BUILD time by astro.config.mjs as well as at runtime, so after
# changing it the project must be redeployed, not just restarted.
CMS_REVALIDATE_TOKEN=

# ── Cloudinary ─────────────────────────────────────────────────────────────
# All three are REQUIRED. They power both halves of the CMS: the media library
# (upload, replace, delete) and the content record itself, which is stored as a
# Cloudinary `raw` asset. Without them the site still renders from the committed
# seed, but nothing can be saved.
#
# Find them at Cloudinary → Settings → API Keys.
#
# The API secret signs uploads and deletes: anyone holding it can write to or
# wipe the account. It is only ever read server-side — the browser uploads
# directly to Cloudinary using a signature this site issues, so image bytes
# never pass through a serverless function and the secret never leaves it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OPTIONAL. The folder the media library reads and writes. Defaults to `colion`.
CLOUDINARY_FOLDER=colion

# OPTIONAL. Where the CMS document itself is stored, as a Cloudinary `raw`
# asset. Defaults to `cms/site-content.json`. Raw assets keep their extension
# in the public id, so this is the id and not a path plus a filename.
CMS_DOCUMENT_ID=cms/site-content.json

# ── Search console verification ────────────────────────────────────────────
# OPTIONAL, one per provider. Empty values are dropped rather than rendered:
# an empty content="" reads as a failed verification, not an absent one.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_META_DOMAIN_VERIFICATION=
PUBLIC_YANDEX_SITE_VERIFICATION=
PUBLIC_PINTEREST_SITE_VERIFICATION=

