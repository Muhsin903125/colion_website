{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "regions": ["bom1"],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/service-details.html", "destination": "/services/", "permanent": true },
    { "source": "/service-details", "destination": "/services/", "permanent": true },
    { "source": "/portfolio-details.html", "destination": "/products/", "permanent": true },
    { "source": "/portfolio-details", "destination": "/products/", "permanent": true },
    { "source": "/sarter-page.html", "destination": "/", "permanent": true },
    { "source": "/sarter-page", "destination": "/", "permanent": true },
    { "source": "/forms/:path*", "destination": "/contact/", "permanent": true },
    { "source": "/assets/img/logo.png", "destination": "/images/brand/colion-logo.png", "permanent": true },
    { "source": "/assets/img/favicon.png", "destination": "/favicon-32.png", "permanent": true },
    { "source": "/assets/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|woff2|avif|mp4|webm)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
